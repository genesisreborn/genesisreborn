{
  "name": "installment-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram bot (Cloudflare Workers + D1) that tracks loan/installment payments, interest, reminders and daily expenses.",
  "scripts": {
    "test": "node --test test/*.test.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute installment-bot --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute installment-bot --local --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
