# ---- Telegram ----
# 在 Telegram 找 @BotFather 创建机器人，拿到 token
TELEGRAM_BOT_TOKEN=
# 可选：固定推送的 chat id，逗号分隔（用户也可以对机器人发 /start 自行订阅）
TELEGRAM_CHAT_IDS=

# ---- Claude（生成 AI 报告；只在出报告时调用一次，定时刷新不调用；不填则用规则引擎）----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---- 调度 ----
TIMEZONE=Asia/Shanghai
# 每隔多少分钟刷新一次资讯、行情和热度榜（免费，不调用 Claude）
REFRESH_MINUTES=15
# 每日 AI 报告时间（24h，逗号分隔，按 TIMEZONE）：每个时间点调用一次 Claude 并推送 Telegram
DAILY_REPORT_TIMES=08:30,21:00
# 手动触发 POST /api/report 的冷却时间（分钟），防止重复调用 Claude
REPORT_COOLDOWN_MINUTES=30
# 可选：设置后，生成报告、保存/删除策略、修改关注列表等写操作需要带 token（服务暴露在公网时务必设置）
API_TOKEN=

# ---- 行情数据 / 策略信号 ----
# 可选：Massive（原 Polygon.io）API Key。填了用 Massive 行情，不填用 Yahoo Finance（免费，有延迟）
MASSIVE_API_KEY=
# 每隔多少分钟拉取新 K 线并运行已启用的策略
SIGNAL_REFRESH_MINUTES=5
# 回测成本（基点，5 = 0.05%）
COMMISSION_BPS=5
SLIPPAGE_BPS=5
# 盘中异动提醒：新进入前 N 名且分数 >= 阈值时推送
ALERT_TOP_N=5
ALERT_MIN_SCORE=70

# ---- 其他 ----
DB_PATH=data/stockpulse.db
# 额外关注的股票（总会纳入分析），逗号分隔
WATCHLIST=AAPL,NVDA,TSLA,MSFT,AMZN
# 是否启用 Reddit / StockTwits 社交源
ENABLE_SOCIAL=true
# 离线演示模式（不联网，使用内置样例数据）
DEMO_MODE=false
