# ---- Telegram ----
# 在 Telegram 找 @BotFather 创建机器人，拿到 token
TELEGRAM_BOT_TOKEN=
# 可选：固定推送的 chat id，逗号分隔（用户也可以对机器人发 /start 自行订阅）
TELEGRAM_CHAT_IDS=
# 可选：群聊里允许 /pause /resume 的用户 id（私聊的管理员不需要填）
TELEGRAM_ADMIN_IDS=

# ---- Claude（生成 AI 报告；只在出报告时调用一次，定时刷新不调用；不填则用规则引擎）----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---- 调度 ----
TIMEZONE=Asia/Shanghai
# 每隔多少分钟刷新一次资讯、行情和热度榜（免费，不调用 Claude）
REFRESH_MINUTES=15
# 每日 AI 报告时间（24h，逗号分隔，按 TIMEZONE）：每个时间点调用一次 Claude 并推送 Telegram
DAILY_REPORT_TIMES=08:30,21:00
# 工作日盘前简报（持仓、自选异动、今明财报、当天重要经济数据），只发给 TELEGRAM_CHAT_IDS；留空关闭
BRIEF_TIMES=20:45
# 手动触发 POST /api/report 的冷却时间（分钟），防止重复调用 Claude
REPORT_COOLDOWN_MINUTES=30
# 可选：设置后，生成报告、保存/删除策略、修改关注列表等写操作需要带 token（服务暴露在公网时务必设置）
API_TOKEN=

# ---- 行情数据 / 策略信号 ----
# 可选：Massive（原 Polygon.io）API Key。填了用 Massive 行情，不填用 Yahoo Finance（免费，有延迟）
MASSIVE_API_KEY=
# 每隔多少分钟拉取新 K 线并运行已启用的策略
SIGNAL_REFRESH_MINUTES=5
# ---- 模拟账户 / 盘中实时提醒 ----
# 模拟账户初始资金
PAPER_CAPITAL=100000
# 盘中实时提醒：auto（有 Massive Key 用 WebSocket，否则轮询）| ws | poll | off
REALTIME_MODE=auto
# 轮询模式下多少秒取一次最新价
REALTIME_POLL_SECONDS=20
# Massive WebSocket 地址（一般不用改）
MASSIVE_WS_URL=wss://socket.massive.com/stocks

# ---- 券商自动下单（Alpaca）：默认关闭 ----
# 填 alpaca 才会启用；还需要上面的 API_TOKEN 已设置
BROKER=
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# true = Alpaca 模拟盘（默认，建议先用）；false = 实盘
ALPACA_PAPER=true
# 实盘必须同时填写这一行（原样填 I_UNDERSTAND_REAL_MONEY），否则实盘模式拒绝下单
LIVE_TRADING_CONFIRM=
# 风控上限
MAX_ORDER_NOTIONAL=1000
MAX_DAILY_ORDERS=10
MAX_OPEN_POSITIONS=5
ALLOW_SHORT=false

# 回测成本（基点，5 = 0.05%）
COMMISSION_BPS=5
SLIPPAGE_BPS=5
# 盘中异动提醒：新进入前 N 名且分数 >= 阈值时推送
ALERT_TOP_N=5
ALERT_MIN_SCORE=70

# ---- 其他 ----
DB_PATH=data/stockpulse.db
# 额外关注的股票（总会纳入分析），逗号分隔
WATCHLIST=AAPL,NVDA,TSLA,MSFT,AMZN
# 是否启用 Reddit / StockTwits 社交源
ENABLE_SOCIAL=true
# 离线演示模式（不联网，使用内置样例数据）
DEMO_MODE=false
